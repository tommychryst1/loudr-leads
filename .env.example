WHOP_API_KEY=your_server_api_key
WHOP_ACCOUNT_ID=biz_your_account_id
# Dedicated LOUDR lead product.
WHOP_LEADS_PRODUCT_ID=prod_your_lead_product_id
NEXT_PUBLIC_WHOP_ACCOUNT_ID=biz_your_account_id
WHOP_WEBHOOK_SECRET=your_webhook_signing_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Provisioned automatically by the connected private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Temporary shared admin login. Store only a salted scrypt hash, never a plaintext password.
ADMIN_USERNAME=your_admin_username
# scrypt$<16-byte-salt-base64url>$<64-byte-derived-key-base64url>
ADMIN_PASSWORD_HASH=
# Random server-only value of at least 32 characters, separate from the admin password.
ADMIN_SESSION_SECRET=
